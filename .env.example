# ============================================
# ANS AI - Variables de Entorno
# ============================================
# Copia este archivo como .env y llena tus datos

# Clave secreta para sesiones Flask (cambiala en produccion)
SECRET_KEY=ans-ai-secret-change-this-in-production

# Google OAuth 2.0
# Para obtener estas credenciales:
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto nuevo (ej: "ans-ai")
# 3. Ve a "APIs y servicios" > "Pantalla de consentimiento"
#    - Selecciona "Externo"
#    - Llena el nombre de la app
#    - Agrega tu email como email de soporte
#    - Guarda
# 4. Ve a "Credenciales" > "Crear credenciales" > "ID de cliente OAuth"
#    - Tipo: Aplicacion web
#    - Nombre: ANS AI
#    - URI de redireccionamiento autorizados: http://localhost:5000/auth/google/callback
# 5. Copia el Client ID y Client Secret aqui abajo
# 6. Ve a "APIs y servicios" > "Biblioteca" y busca "Google+ API" > Habilitala

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
